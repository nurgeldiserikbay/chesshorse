{
	"name": "chesshorse",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"deploy": "yarn build:prod && gh-pages -d docs --remote origin --branch main",
		"dev": "vite --mode development",
		"dev:prod": "vite --mode production",
		"build": "vite build --mode development",
		"build:prod": "vite build --mode production",
		"assets": "npm rebuild --verbose sharp && npx capacitor-assets generate",
		"preview": "vite preview",
		"build:android": "pnpm build && npx cap sync && npx cap open android",
		"build:android:prod": "pnpm build:prod && npx cap sync && npx cap open android"
	},
	"dependencies": {
		"@boengli/capacitor-fullscreen": "^0.0.19",
		"@capacitor-community/admob": "^8.0.0",
		"@capacitor/android": "^8.5.0",
		"@capacitor/app": "^8.1.1",
		"@capacitor/core": "^8.5.0",
		"@capacitor/ios": "^8.5.0",
		"@capacitor/preferences": "^8.0.1",
		"@capacitor/screen-orientation": "^8.0.1",
		"@capacitor/splash-screen": "^8.0.2",
		"@capacitor/status-bar": "^8.0.3",
		"html2canvas": "^1.4.1",
		"pinia": "^2.1.7",
		"pinia-plugin-persistedstate": "^3.2.1",
		"sass": "^1.71.1",
		"vite-svg-loader": "^5.1.0",
		"vue": "^3.4.19"
	},
	"devDependencies": {
		"@capacitor/assets": "^3.0.5",
		"@capacitor/cli": "^8.5.0",
		"@vite-pwa/assets-generator": "^0.2.4",
		"@vitejs/plugin-vue": "^5.0.4",
		"capacitor-set-version": "^2.2.0",
		"gh-pages": "^6.3.0",
		"typescript": "^5.2.2",
		"vite": "^5.1.4",
		"vite-plugin-pwa": "^0.19.4",
		"vue-tsc": "^1.8.27"
	}
}
